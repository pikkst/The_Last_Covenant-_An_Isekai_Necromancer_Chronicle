generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String   @id @default(cuid())
  email           String   @unique
  emailNormalized String   @unique @map("email_normalized")
  passwordHash    String   @map("password_hash")
  status          String   @default("ACTIVE")
  locale          String   @default("en")
  securityVersion Int      @default(0) @map("security_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  securityAuditEvents  SecurityAuditEvent[]
  guestProfile         GuestProfile?
  saveSlots            SaveSlot[]

  @@map("accounts")
  @@index([emailNormalized])
}

model Session {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  tokenHash    String   @unique @map("token_hash")
  familyId     String   @map("family_id")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastSeenAt   DateTime @map("last_seen_at")
  userAgent    String?
  ipHash       String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([accountId])
  @@index([tokenHash])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([accountId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  accountId String?  @map("account_id")
  category  String
  action    String
  outcome   String
  traceId   String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("security_audit_events")
  @@index([accountId])
  @@index([category, action])
  @@index([createdAt])
}

model GuestProfile {
  id         String   @id @default(cuid())
  accountId  String   @unique @map("account_id")
  createdAt  DateTime @default(now()) @map("created_at")
  upgradedAt DateTime? @map("upgraded_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("guest_profiles")
}

model SaveSlot {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  name          String
  status        String   @default("ACTIVE")
  contentVersion String  @default("0.1.0") @map("content_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  archivedAt    DateTime? @map("archived_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  revisions SaveRevision[]

  @@index([accountId, updatedAt])
  @@map("save_slots")
}

model SaveRevision {
  id            String   @id @default(cuid())
  saveSlotId    String   @map("save_slot_id")
  revision      Int
  data          String
  checksum      String
  contentVersion String  @default("0.1.0") @map("content_version")
  createdAt     DateTime @default(now()) @map("created_at")

  saveSlot SaveSlot @relation(fields: [saveSlotId], references: [id], onDelete: Cascade)
  checkpoints SaveCheckpoint[]

  @@unique([saveSlotId, revision])
  @@index([saveSlotId])
  @@map("save_revisions")
}

model SaveCheckpoint {
  id            String   @id @default(cuid())
  saveSlotId    String   @map("save_slot_id")
  revisionId    String   @map("revision_id")
  label         String?
  createdAt     DateTime @default(now()) @map("created_at")

  revision SaveRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([saveSlotId])
  @@map("save_checkpoints")
}
